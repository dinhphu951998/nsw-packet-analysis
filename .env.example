# --- network ---
LAB_SUBNET=172.28.0.0/24
LAB_GATEWAY=172.28.0.1
TARGET_IP=172.28.0.10
ATTACKER_IP=172.28.0.20

# --- capture ---
# file written under captures/
PCAP_FILE=combined.pcap
# 0 = full packets
CAPTURE_SNAPLEN=0
# pause so tcpdump is recording before traffic starts
SETTLE_SECONDS=2

# --- activity 1: scanning ---
SCAN_PORTS=1-1024
# nmap -T template (0-5)
SCAN_TIMING=4

# --- activity 2: beaconing ---
BEACON_PATH=/heartbeat
# seconds between callbacks
BEACON_INTERVAL=5
# number of callbacks
BEACON_COUNT=20

# --- activity 3: unusual traffic ---
ODD_PORTS=4444,6666,31337
# bytes of random payload sent to each odd port
ODD_PAYLOAD_SIZE=2048
# packets per flag pattern, per odd port
CRAFTED_PACKETS=10

# --- activity 4: denial of service (bounded) ---
# total SYN packets in the flood (hard cap)
DOS_SYN_COUNT=2000
# packets/sec
DOS_SYN_RATE=500
# port under attack
DOS_TARGET_PORT=80
# HTTP flood request count
DOS_HTTP_REQUESTS=1000
# parallel connections for the HTTP flood
DOS_HTTP_CONCURRENCY=20
